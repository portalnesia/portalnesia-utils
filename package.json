{
  "name": "@portalnesia/utils",
  "version": "1.1.12",
  "description": "Utility for Portalnesia",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portalnesia/portalnesia-utils.git"
  },
  "files": [
    "README.md",
    "dist",
    "package.json",
    "LICENSE"
  ],
  "keywords": [
    "utility",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "author": "Putu Aditya <aditya@portalnesia.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/portalnesia/portalnesia-utils/issues"
  },
  "homepage": "https://portalnesia.com",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/lodash.deburr": "^4.1.6",
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "lodash.deburr": "^4.1.0",
    "nanoid": "^3.3.4",
    "uuid": "^9.0.0"
  }
}

{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "noEmitOnError": true,
    "strict": true,
    "target": "es2022",
    "rootDir": "./src",
    "declarationDir": "./dist",
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": [
      "@types/bun"
    ],
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "node_modules",
    "./dist"
  ]
}